    "交互": ["ask_user_question", "todo"],
    "子代理": ["omo_subagent", "omo_council"]
  },
  "search": {
    "type": "subagent",
    "delegates": [],
    "label": "查阅",
    "roles": ["读", "搜索"]
  }
