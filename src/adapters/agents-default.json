{
  "main": {
    "type": "main",
    "tools": ["*"],
    "delegates": ["search", "fixer", "oracle"],
    "presetPrimary": true,
    "label": "Main session"
  },
  "oracle": {
    "type": "subagent",
    "delegates": [],
    "label": "评审",
    "roles": ["读", "搜索", "检索"]
  },
  "fixer": {
    "type": "subagent",
    "delegates": [],
    "label": "实现",
    "roles": ["读", "写", "执行", "检索"]
  },
  "_tool_groups": {
    "读": ["read"],
    "写": ["write", "edit"],
    "执行": ["bash"],
    "检索": ["codebase_*", "context_mode_ctx_search"],
    "搜索": [
      "grep",
      "find",
      "ls",
      "web_search",
      "code_search",
      "fetch_content",
      "get_search_content"
