{
  "name": "pi-shiki-subagents",
  "version": "1.0.4",
  "description": "Pi extension: light multi-agent orchestration layer (pi-shiki). Fork of oh-my-opencode-slim; OpenCode 形态已移除。",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi-extension",
    "ai",
    "agents",
    "orchestration",
    "multi-agent"
  ],
  "pi": {
    "extensions": [
      "./src/pi/core/pi.ts"
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/RoyougiShiki/Pi-shiki-subagents"
  },
  "bugs": {
    "url": "https://github.com/RoyougiShiki/Pi-shiki-subagents/issues"
  },
  "homepage": "https://github.com/RoyougiShiki/Pi-shiki-subagents#readme",
  "files": [
    "src/pi",
    "src/adapters",
    "src/config",
    "README.md",
    "LICENSE",
    "pi-shiki-subagents.schema.json"
  ],
  "scripts": {
    "contributors:add": "all-contributors add",
    "contributors:check": "all-contributors check",
    "contributors:generate": "all-contributors generate",
    "pi:sync": "bun run scripts/pi-dev-sync.ts",
    "pi:sync:write": "bun run scripts/pi-dev-sync.ts --write",
    "pi:sync:check": "bun run scripts/pi-dev-sync.ts --check",
    "typecheck": "node ./node_modules/typescript/bin/tsc --noEmit",
    "test": "bun test",
    "lint": "biome lint .",
    "format": "biome format . --write",
    "check": "biome check --write .",
    "check:ci": "biome check ."
  },
  "dependencies": {
    "lru-cache": "^11.3.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.11",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^24.6.1",
    "@types/turndown": "^5.0.6",
    "all-contributors-cli": "^6.26.1",
    "bun-types": "1.3.12",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*",
    "zod": "*"
  },
  "trustedDependencies": [],
  "peerDependenciesMeta": {
    "typebox": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  }
}