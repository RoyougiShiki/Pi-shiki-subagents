{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri"
    },
    "preset": {
      "type": "string"
    },
    "setDefaultAgent": {
      "type": "boolean"
    },
    "scoringEngineVersion": {
      "type": "string",
      "enum": [
        "v1",
        "v2-shadow",
        "v2"
      ]
    },
    "balanceProviderUsage": {
      "type": "boolean"
    },
    "showStartupToast": {
      "description": "Show the startup activation toast when OpenCode starts. Defaults to true.",
      "type": "boolean"
    },
    "autoUpdate": {
      "description": "Disable automatic installation of plugin updates when false. Defaults to true.",
      "type": "boolean"
    },
    "manualPlan": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "primary": {
            "type": "string",
            "pattern": "^[^/\\s]+\\/[^\\s]+$"
          },
          "fallback1": {
            "type": "string",
            "pattern": "^[^/\\s]+\\/[^\\s]+$"
          },
          "fallback2": {
            "type": "string",
            "pattern": "^[^/\\s]+\\/[^\\s]+$"
          },
          "fallback3": {
            "type": "string",
            "pattern": "^[^/\\s]+\\/[^\\s]+$"
          }
        },
        "required": [
          "primary",
          "fallback1",
          "fallback2",
          "fallback3"
        ]
      }
    },
    "presets": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "propertyNames": {
          "type": "string"
        },
        "additionalProperties": {
          "type": "string",
          "pattern": "^[^/\\s]+\\/[^\\s]+$"
        }
      }
    },
    "agents": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "model": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "minItems": 1,
                "type": "array",
                "items": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "variant": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "id"
                      ]
                    }
                  ]
                }
              }
            ]
          },
          "temperature": {
            "type": "number",
            "minimum": 0,
            "maximum": 2
          },
          "variant": {
            "type": "string"
          },
          "thinking": {
            "type": "string"
          },
          "skills": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "mcps": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "type": {
            "type": "string",
            "enum": [
              "main",
              "subagent"
            ]
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "tools": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "delegates": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "hidden": {
            "type": "boolean"
          },
          "label": {
            "type": "string"
          },
          "prompt": {
            "type": "string",
            "minLength": 1
          },
          "options": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          },
          "displayName": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "_tool_groups": {
      "description": "Named tool expression groups. Agent roles and @group tool entries resolve through this map.",
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "disabled_agents": {
      "description": "Agent names to omit from generated AvailableAgents and delegation hints. Agents listed here are not advertised for delegation hints. Use this for optional agents you do not want surfaced in runtime prompts.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "disabled_mcps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "interview": {
      "type": "object",
      "properties": {
        "maxQuestions": {
          "default": 2,
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "outputFolder": {
          "default": "interview",
          "type": "string",
          "minLength": 1
        },
        "autoOpenBrowser": {
          "default": true,
          "description": "Automatically open the interview UI in your default browser during interactive runs. Disabled automatically in tests and CI.",
          "type": "boolean"
        },
        "port": {
          "default": 0,
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "dashboard": {
          "default": false,
          "type": "boolean"
        }
      }
    },
    "sessionManager": {
      "type": "object",
      "properties": {
        "maxSessionsPerAgent": {
          "default": 2,
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "readContextMinLines": {
          "default": 10,
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "readContextMaxFiles": {
          "default": 8,
          "type": "integer",
          "minimum": 0,
          "maximum": 50
        }
      }
    },
    "todoContinuation": {
      "type": "object",
      "properties": {
        "maxContinuations": {
          "default": 5,
          "description": "Maximum consecutive auto-continuations before stopping to ask user",
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        },
        "cooldownMs": {
          "default": 3000,
          "description": "Delay in ms before auto-continuing (gives user time to abort)",
          "type": "integer",
          "minimum": 0,
          "maximum": 30000
        },
        "autoEnable": {
          "default": false,
          "description": "Automatically enable auto-continue when the primary session has enough todos",
          "type": "boolean"
        },
        "autoEnableThreshold": {
          "default": 4,
          "description": "Number of todos that triggers auto-enable (only used when autoEnable is true)",
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        }
      }
    },
    "fallback": {
      "type": "object",
      "properties": {
        "enabled": {
          "default": true,
          "type": "boolean"
        },
        "timeoutMs": {
          "default": 15000,
          "type": "number",
          "minimum": 0
        },
        "retryDelayMs": {
          "default": 500,
          "type": "number",
          "minimum": 0
        },
        "chains": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "retry_on_empty": {
          "default": true,
          "description": "When true (default), empty provider responses are treated as failures, triggering fallback/retry. Set to false to treat them as successes.",
          "type": "boolean"
        }
      }
    },
    "harness": {
      "type": "object",
      "properties": {
        "completionAuditor": {},
        "toolResultBudget": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "thresholds": {
              "type": "object",
              "properties": {
                "default": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "byTool": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  }
                }
              },
              "additionalProperties": false
            },
            "previewChars": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "storageBaseDir": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "messages": {
          "type": "object",
          "properties": {
            "verificationEvidence": {
              "type": "object",
              "properties": {
                "subagentPending": {
                  "type": "string"
                },
                "toolFailedWithoutRecovery": {
                  "type": "string"
                },
                "modificationWithoutVerification": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            },
            "completionAuditor": {},
            "toolResultBudget": {
              "type": "object",
              "properties": {
                "persistedOutputTemplate": {
                  "type": "string"
                },
                "clearedOutputTemplate": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "subagent": {
          "type": "object",
          "properties": {
            "stallTimeoutMs": {
              "description": "Sub-agent stall detection: treat the LLM stream phase as dead when no session events arrive for this many ms. 0 disables detection. Default 120000.",
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "promptTimeoutMs": {
              "description": "Per-prompt hard timeout for sub-agents (ms). 0 disables. Default 600000.",
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "council": {
      "type": "object",
      "properties": {
        "presets": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {}
            }
          }
        },
        "timeout": {
          "default": 180000,
          "type": "number",
          "minimum": 0
        },
        "default_preset": {
          "default": "default",
          "type": "string"
        },
        "councillor_execution_mode": {
          "default": "parallel",
          "description": "Execution mode for councillors. \"serial\" runs them one at a time (required for single-model systems). \"parallel\" runs them concurrently (default, faster for multi-model systems).",
          "type": "string",
          "enum": [
            "parallel",
            "serial"
          ]
        },
        "meeting_backend": {
          "default": "session",
          "description": "Backend for Pi omo_council(mode=\"meeting\"). \"session\" is stable/default; \"collaborating\" is reserved for future pi-collaborating-agents integration.",
          "type": "string",
          "enum": [
            "session",
            "collaborating"
          ]
        },
        "councillor_retries": {
          "default": 3,
          "description": "Number of retry attempts for councillors that return empty responses (e.g. due to provider rate limiting). Default: 3 retries.",
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "master": {
          "description": "DEPRECATED — ignored. Council agent synthesizes directly."
        },
        "master_timeout": {
          "description": "DEPRECATED — ignored. Use \"timeout\" instead."
        },
        "master_fallback": {
          "description": "DEPRECATED — ignored. No separate master session."
        }
      },
      "required": [
        "presets"
      ]
    },
    "visionModel": {
      "description": "Model ID (provider/model format) for the vision_analyze tool. This model is used to analyze images via direct API call. Defaults to \"dmxapi/glm-4.1v-thinking-flash\" if not set.",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "title": "oh-my-opencode-slim",
  "description": "Configuration schema for oh-my-opencode-slim plugin for OpenCode"
}
